@page "/Autores/Edit/{IdAutor:int}"
@rendermode InteractiveServer

@inject AutoresService autoresService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Edit</PageTitle>

<EditForm Model="Autor" OnValidSubmit="Modificar" FormName="editarAutores">
	<DataAnnotationsValidator />

	<div class="container">
		<div class="card shadow-lg">

			<div class="card-header text-center">
				<h5 class="card-title">Editar Autor</h5>
			</div>

			<div class="card-body">

				@* IdAutor *@
				<div class="mb-3">
					<label class="form-label"><strong>IdAutor</strong></label>
					<InputNumber class="form-control" @bind-Value="Autor.IdAutor" readonly></InputNumber>
				</div>

				@* Nombres *@
				<div class="mb-3">
					<label class="form-label"><strong>Nombres</strong></label>
					<InputText class="form-control" @bind-Value="Autor.Nombres"></InputText>
					<ValidationMessage For="(() => Autor.Nombres)" />
				</div>

				@* Nacionalidad *@
				<div class="mb-3">
					<label class="form-label"><strong>Nacionalidad</strong></label>
					<InputText class="form-control" @bind-Value="Autor.Nacionalidad"></InputText>
					<ValidationMessage For="(() => Autor.Nacionalidad)" />
				</div>

				@* FechaNacimiento *@
				<div class="mb-3">
					<label class="form-label"><strong>FechaNacimiento</strong></label>
					<InputDate class="form-control" @bind-Value="Autor.FechaNacimiento" max="@DateTime.Today.ToString("yyyy-MM-dd")"></InputDate>
					<ValidationMessage For="(() => Autor.FechaNacimiento)" />
				</div>

				@* Sueldo *@
				<div class="mb-3">
					<label class="form-label"><strong>Sueldo</strong></label>
					<InputNumber class="form-control" @bind-Value="Autor.Sueldo"></InputNumber>
					<ValidationMessage For="(() => Autor.Sueldo)" />
				</div>

			</div>

			@* footer *@
			<div class="card-footer text-center mt-2">
				<a href="/Autores/Index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span> Volver</a>
				<button type="submit" class="btn btn-primary bi bi-floppy"> Guardar</button>
				<button type="button" class="btn btn-danger bi bi-trash" data-bs-toggle="modal" data-bs-target="#modalEliminar"> Eliminar</button>
			</div>

		</div>
	</div>
</EditForm>

@* Modal para eliminar *@
<div class="modal fade" id="modalEliminar" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header">
				<h5 class="modal-title">Confirmar Eliminación</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>

			<div class="modal-body">
					<p>¿Desea eliminar al autor @Autor.Nombres?</p>
			</div>

			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"> Cancelar</button>
				<button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="ConfirmarEliminar"> Eliminar</button>
			</div>

		</div>
	</div>
</div>

@code {
	[Parameter]
	public int IdAutor { get; set; }
    public Autores Autor { get; set; } = new Autores();

	protected override async Task OnInitializedAsync()
	{
		var autorEncontrado = await autoresService.Buscar(IdAutor);

		if (autorEncontrado != null)
		{
			Autor = autorEncontrado;
		}
		else
		{
			navigationManager.NavigateTo("/Autores/Index");
		}
	}

	private async Task Modificar()
	{
		if (Autor.FechaNacimiento.Date > DateTime.Today)
		{
			toastService.ShowError("La fecha de nacimiento no puede superar la fecha actual");
			return;
		}

		if (await autoresService.ExisteNombre(Autor.Nombres, Autor.IdAutor))
		{
			toastService.ShowError("Ya existe un autor con ese nombre");
			return;
		}

		var modificado = await autoresService.Guardar(Autor);

		if (modificado)
		{
			toastService.ShowSuccess("Autor modificado correctamente");
			navigationManager.NavigateTo("/Autores/Index");
		}
		else
		{
			toastService.ShowError("No se ha podido modificar el autor");
		}
	}

	private async Task ConfirmarEliminar()
    {
        var eliminado = await autoresService.Eliminar(Autor.IdAutor);

        if (eliminado)
        {
            toastService.ShowSuccess("Autor eliminado correctamente");
            navigationManager.NavigateTo("/Autores/Index");
        }
        else
        {
            toastService.ShowError("No se ha podido eliminar el autor");
        }
    }
}
