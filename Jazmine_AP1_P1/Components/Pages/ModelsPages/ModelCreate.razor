@page "/Models/Create"
@rendermode InteractiveServer

@inject AutoresService autoresService
@inject NavigationManager navigationManager
@inject ToastService toastService

<PageTitle>Create</PageTitle>

<EditForm Model="Autor" OnValidSubmit="Guardar" FormName="crearAutores">
	<DataAnnotationsValidator />

	<div class="container">
		<div class="card shadow-lg">

			<div class="card-header d-flex justify-content-between align-content-center mb-4">
				<h5 class="card-title">Crear Autor</h5>
			</div>

			<div class="card-body">

				@* IdAutor *@
				<div class="mb-3">
					<label class="form-label"><strong>IdAutor</strong></label>
					<InputNumber class="form-control" @bind-Value="Autor.IdAutor" readonly></InputNumber>
				</div>

				@* Nombres *@
				<div class="mb-3">
					<label class="form-label"><strong>Nombres</strong></label>
					<InputText class="form-control" @bind-Value="Autor.Nombres"></InputText>
					<ValidationMessage For="(() => Autor.Nombres)" />
				</div>

				@* Nacionalidad *@
				<div class="mb-3">
					<label class="form-label"><strong>Nacionalidad</strong></label>
					<InputText class="form-control" @bind-Value="Autor.Nacionalidad"></InputText>
					<ValidationMessage For="(() => Autor.Nacionalidad)" />
				</div>

				@* FechaNacimiento *@
				<div class="mb-3">
					<label class="form-label"><strong>FechaNacimiento</strong></label>
					<InputDate class="form-control" @bind-Value="Autor.FechaNacimiento"></InputDate>
					<ValidationMessage For="(() => Autor.FechaNacimiento)" />
				</div>

				@* Sueldo *@
				<div class="mb-3">
					<label class="form-label"><strong>Sueldo</strong></label>
					<InputNumber class="form-control" @bind-Value="Autor.Sueldo"></InputNumber>
					<ValidationMessage For="(() => Autor.Sueldo)" />
				</div>

				@* footer *@
				<div class="card-footer">
					<a href="/Autores/Index" class="btn btn-secondary"> Volver</a>
					<button type="button" @onclick="Guardar"> Guardar</button>
				</div>
			</div>
		</div>
	</div>
</EditForm>

@code {
	public Autores Autor { get; set; } = new Autores();

	protected override void OnInitializedAsync()
	{
		Autor.FechaNacimiento = DateTime.Today;
	}

	private async Task Guardar()
	{
		var guardado = await autoresService.Guardar(Autor);

		if (guardado)
		{
			toastService.ShowSuccess("Autor guardado correctamente");
			navigationManager.NavigateTo("/Autores/Index");
		}
		else
		{
			toastService.ShowError("No se ha podido guardar el autor");
		}
	}
}
